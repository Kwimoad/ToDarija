{
  "manifest_version": 3,
  "name": "Translation Side Panel",
  "version": "1.0",
  "description": "Translate text using the side panel API",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Open Translation Panel"
  },
  "side_panel": {
    "default_path": "login-panel.html"
  },
  "icons": {
    "16": "icons/ToDarija_icon.png",
    "48": "icons/ToDarija_icon.png",
    "128": "icons/ToDarija_icon.png"
  }
}
